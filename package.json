{
  "name": "norch",
  "version": "0.1.0",
  "license": "MIT",
  "description": "PyTorch equivalent for Node.js wrapping libtorch (c10, ATen, torch::autograd, c10d, Kineto, and torch::jit) via C++23 Node-API",
  "keywords": [
    "pytorch",
    "libtorch",
    "deep-learning",
    "machine-learning",
    "tensors",
    "autograd",
    "cuda",
    "gpu",
    "neural-networks",
    "jit",
    "node-api"
  ],
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "CMakeLists.txt",
    "bin/",
    "dist/src/",
    "native/",
    "scripts/build-native.mjs",
    "scripts/codegen.mjs",
    "scripts/download-libtorch.mjs",
    "scripts/find-libtorch.mjs",
    "scripts/prebuild.mjs"
  ],
  "bin": {
    "norch-setup": "./bin/norch-setup.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./nn": {
      "types": "./dist/src/nn/index.d.ts",
      "import": "./dist/src/nn/index.js"
    },
    "./optim": {
      "types": "./dist/src/optim/index.d.ts",
      "import": "./dist/src/optim/index.js"
    },
    "./utils": {
      "types": "./dist/src/utils/index.d.ts",
      "import": "./dist/src/utils/index.js"
    },
    "./distributed": {
      "types": "./dist/src/distributed.d.ts",
      "import": "./dist/src/distributed.js"
    },
    "./special": {
      "types": "./dist/src/special.d.ts",
      "import": "./dist/src/special.js"
    },
    "./distributions": {
      "types": "./dist/src/distributions.d.ts",
      "import": "./dist/src/distributions.js"
    },
    "./func": {
      "types": "./dist/src/func.d.ts",
      "import": "./dist/src/func.js"
    },
    "./profiler": {
      "types": "./dist/src/profiler.d.ts",
      "import": "./dist/src/profiler.js"
    },
    "./jit": {
      "types": "./dist/src/jit.d.ts",
      "import": "./dist/src/jit.js"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "codegen": "node scripts/codegen.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:native && npm run codegen && npm run build:ts",
    "test": "CUDA_VISIBLE_DEVICES='' OMP_NUM_THREADS=4 node --test --test-concurrency=4 dist/test/*.test.js",
    "test:cuda": "NORCH_TEST_CUDA=1 node --test dist/test/cuda.test.js",
    "test:asan": "node scripts/test-asan.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:cuda": "node scripts/bench-cuda.mjs",
    "lint:cpp": "node scripts/lint-cpp.mjs",
    "setup:libtorch": "node scripts/download-libtorch.mjs",
    "stage:prebuild": "node scripts/prebuild.mjs"
  },
  "dependencies": {
    "node-addon-api": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
